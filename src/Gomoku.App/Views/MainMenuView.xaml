<UserControl x:Class="Gomoku.App.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="WoodBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F4E6CB" Offset="0"/>
            <GradientStop Color="#E7CFA3" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BlackStoneBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="WhiteStoneBrush" Color="#FFFFFF"/>
        <LinearGradientBrush x:Key="HalfStoneBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1F1F1F" Offset="0"/>
            <GradientStop Color="#1F1F1F" Offset="0.49"/>
            <GradientStop Color="#FFFFFF" Offset="0.51"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="StoneShadow" BlurRadius="6" ShadowDepth="2" Opacity="0.35"/>
        <DropShadowEffect x:Key="TitleShadow" BlurRadius="8" ShadowDepth="3" Opacity="0.3"/>

        <Style x:Key="StoneButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A3728"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                            <Ellipse x:Name="StoneEllipse" Width="88" Height="88"
                                     Fill="{TemplateBinding Tag}" Stroke="#8A6D4F" StrokeThickness="2"
                                     Effect="{StaticResource StoneShadow}"/>
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="./Assets/Fonts/#Zhi Mang Xing"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StoneEllipse" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StoneEllipse" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource WoodBrush}">
        <!-- 水墨墨渍装饰 -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="200" Height="150" Fill="#4A3728" Opacity="0.06" Canvas.Left="30" Canvas.Top="70"/>
            <Ellipse Width="90" Height="120" Fill="#4A3728" Opacity="0.08" Canvas.Left="540" Canvas.Top="500"/>
            <Ellipse Width="60" Height="50" Fill="#4A3728" Opacity="0.1" Canvas.Left="110" Canvas.Top="560"/>
            <Ellipse Width="240" Height="90" Fill="#4A3728" Opacity="0.05" Canvas.Left="400" Canvas.Top="110"/>
            <Ellipse Width="42" Height="60" Fill="#4A3728" Opacity="0.12" Canvas.Left="570" Canvas.Top="620"/>
        </Canvas>

        <!-- 回纹双线边框 -->
        <Border BorderBrush="#8A6D4F" BorderThickness="2" Margin="16" CornerRadius="2"/>
        <Border BorderBrush="#B08D63" BorderThickness="1" Margin="26" CornerRadius="2"/>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="趣味五子棋" FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="52" Foreground="#4A3728"
                       HorizontalAlignment="Center" Effect="{StaticResource TitleShadow}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,72,0,0">
                <Button Style="{StaticResource StoneButtonStyle}" Tag="{StaticResource BlackStoneBrush}"
                        Content="人机对战" Click="VsAi_Click" Margin="0,0,30,0"/>
                <Button Style="{StaticResource StoneButtonStyle}" Tag="{StaticResource WhiteStoneBrush}"
                        Content="本地双人" Click="LocalTwoPlayer_Click" Margin="0,0,30,0"/>
                <Button Style="{StaticResource StoneButtonStyle}" Tag="{StaticResource HalfStoneBrush}"
                        Content="联机对战" Click="Online_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <TextBlock Text="AI 难度" FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="15" Foreground="#4A3728"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="DifficultyCombo" Width="116"
                          FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="14" Foreground="#4A3728"
                          VerticalContentAlignment="Center"
                          SelectionChanged="DifficultyCombo_SelectionChanged">
                    <ComboBoxItem Content="小白"/>
                    <ComboBoxItem Content="菜鸟"/>
                    <ComboBoxItem Content="新手"/>
                    <ComboBoxItem Content="入门"/>
                    <ComboBoxItem Content="普通"/>
                    <ComboBoxItem Content="高手"/>
                    <ComboBoxItem Content="专家"/>
                    <ComboBoxItem Content="大师"/>
                    <ComboBoxItem Content="巅峰"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <TextBlock Text="棋盘材质" FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="15" Foreground="#4A3728"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="BoardMaterialCombo" Width="116"
                          FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="14" Foreground="#4A3728"
                          VerticalContentAlignment="Center"
                          SelectionChanged="BoardMaterialCombo_SelectionChanged">
                    <ComboBoxItem Content="木质棋盘"/>
                    <ComboBoxItem Content="石制棋盘"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock Text="背景" FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="15" Foreground="#4A3728"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="BackgroundCombo" Width="116"
                          FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="14" Foreground="#4A3728"
                          VerticalContentAlignment="Center"
                          SelectionChanged="BackgroundCombo_SelectionChanged">
                    <ComboBoxItem Content="无背景"/>
                    <ComboBoxItem Content="动态四季"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="双人轮流落子 · 五子连线即胜" FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="14" Foreground="#8A6D4F"
                       HorizontalAlignment="Center" Margin="0,32,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button x:Name="FullScreenButton" Content="全屏" Width="70" Height="30" FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="13"
                        Click="FullScreen_Click" Margin="0,0,12,0" ToolTip="F11 也可切换全屏"/>
                <Button Content="退出游戏" Width="90" Height="30" FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="13"
                        Click="Exit_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- 人机对战：选择执子颜色 -->
        <Border x:Name="ColorPickPanel" Visibility="Collapsed" Background="#EAF4E6CB" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Padding="28,24,28,22"
                BorderBrush="#8A6D4F" BorderThickness="2">
            <StackPanel>
                <TextBlock Text="请选择执子颜色" FontFamily="./Assets/Fonts/#Zhi Mang Xing" FontSize="28" Foreground="#4A3728"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="黑方先行 · 白方后行" FontSize="13" Foreground="#8A6D4F"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="执黑子" Width="136" Height="48" FontSize="16" Click="PickBlack_Click"
                            Margin="0,0,18,0"/>
                    <Button Content="执白子" Width="136" Height="48" FontSize="16" Click="PickWhite_Click"/>
                </StackPanel>
                <Button Content="取消" Width="80" Height="30" FontSize="13" Click="ColorPickCancel_Click"
                        HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
