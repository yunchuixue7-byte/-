<UserControl x:Class="Gomoku.App.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="./Assets/Fonts/#Zhi Mang Xing">
    <Grid Background="#EFE6D6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部返回 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,0,0">
            <Button Content="← 返回" Width="70" Height="32" FontSize="13"
                    Click="Back_Click" Cursor="Hand"/>
        </StackPanel>

        <!-- 中央面板（内容较多，小窗口时可滚动） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,24">
                <TextBlock Text="联机对战" FontSize="40" Foreground="#4A3728" HorizontalAlignment="Center"/>
                <TextBlock Text="登录后记录战绩并按胜率匹配，不登录也能用房号对战" FontSize="14" Foreground="#8B6B45"
                           HorizontalAlignment="Center" Margin="0,6,0,18" TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- 服务器地址 -->
                <TextBlock Text="服务器地址" FontSize="14" Foreground="#6B5237"/>
                <TextBox x:Name="ServerBox" Text="127.0.0.1:9527" Height="34" FontSize="15"
                         FontFamily="Microsoft YaHei" Margin="0,6,0,14" VerticalContentAlignment="Center" Padding="8,0"/>

                <!-- 账号卡片 -->
                <Border Background="#F7F1E6" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="账号（可选）" FontSize="15" Foreground="#4A3728"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="用户名" FontSize="12" Foreground="#8B6B45" Margin="2,0,0,3"/>
                                <TextBox x:Name="UserBox" Width="150" Height="34" FontSize="14" MaxLength="16"
                                         FontFamily="Microsoft YaHei" VerticalContentAlignment="Center" Padding="8,0"
                                         ToolTip="用户名：2-16 位中英文、数字或下划线"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="密码" FontSize="12" Foreground="#8B6B45" Margin="2,0,0,3"/>
                                <PasswordBox x:Name="PassBox" Width="130" Height="34" FontSize="14" MaxLength="32"
                                             FontFamily="Microsoft YaHei" Padding="8,0"
                                             ToolTip="密码：至少 4 位"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="注册" Width="88" Height="34" FontSize="15" Cursor="Hand"
                                    Click="Register_Click"/>
                            <Button Content="登录" Width="88" Height="34" FontSize="15" Margin="8,0,0,0"
                                    Cursor="Hand" Click="Login_Click"/>
                            <Button x:Name="LogoutButton" Content="退出登录" Width="100" Height="34" FontSize="14"
                                    Margin="8,0,0,0" Cursor="Hand" Visibility="Collapsed" Click="Logout_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="AccountText" FontSize="14" Foreground="#6B5237" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Text="当前以游客身份对战，战绩不会保存"/>
                    </StackPanel>
                </Border>

                <!-- 快速匹配 -->
                <Button x:Name="MatchButton" Content="快速匹配（按胜率找对手）" Height="42" FontSize="18"
                        Background="#8B6B45" Foreground="#F5EFE3" Cursor="Hand" Click="Match_Click"/>

                <Rectangle Height="1" Fill="#C9B79A" Margin="0,16,0,14"/>

                <Button Content="创建房间" Height="40" FontSize="18" Cursor="Hand"
                        Background="#4A3728" Foreground="#F5EFE3" Click="Create_Click"/>

                <TextBlock x:Name="RoomCodeText" FontSize="24" Foreground="#8B6B45"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>

                <Rectangle Height="1" Fill="#C9B79A" Margin="0,14,0,12"/>

                <TextBlock Text="已有房间号？直接加入" FontSize="14" Foreground="#6B5237"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="RoomBox" Width="180" Height="38" FontSize="20" MaxLength="4"
                             FontFamily="Microsoft YaHei" VerticalContentAlignment="Center" Padding="10,0"
                             ToolTip="输入四位房间号"/>
                    <Button Content="加入房间" Width="150" Height="38" FontSize="18" Margin="12,0,0,0"
                            Cursor="Hand" Click="Join_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" FontSize="15" Foreground="#A0522D"
                           HorizontalAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
