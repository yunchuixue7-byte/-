<UserControl x:Class="Gomoku.App.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="./Assets/Fonts/#Zhi Mang Xing">
    <Grid Background="#EFE6D6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部返回 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,0,0">
            <Button Content="← 返回" Width="70" Height="32" FontSize="13"
                    Click="Back_Click" Cursor="Hand"/>
        </StackPanel>

        <!-- 中央面板 -->
        <StackPanel Grid.Row="1" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="联机对战" FontSize="44" Foreground="#4A3728" HorizontalAlignment="Center"/>
            <TextBlock Text="与好友连接同一台服务器，房主执黑先行" FontSize="15" Foreground="#8B6B45"
                       HorizontalAlignment="Center" Margin="0,6,0,26"/>

            <TextBlock Text="服务器地址" FontSize="14" Foreground="#6B5237"/>
            <TextBox x:Name="ServerBox" Text="127.0.0.1:9527" Height="34" FontSize="16"
                     Margin="0,6,0,18" VerticalContentAlignment="Center" Padding="8,0"/>

            <Button Content="创建房间" Height="42" FontSize="19" Cursor="Hand"
                    Background="#4A3728" Foreground="#F5EFE3" Click="Create_Click"/>

            <TextBlock x:Name="RoomCodeText" FontSize="26" Foreground="#8B6B45"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>

            <Rectangle Height="1" Fill="#C9B79A" Margin="0,20,0,18"/>

            <TextBlock Text="已有房间号？直接加入" FontSize="14" Foreground="#6B5237"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="RoomBox" Width="180" Height="38" FontSize="20" MaxLength="4"
                         VerticalContentAlignment="Center" Padding="10,0" ToolTip="输入四位房间号"/>
                <Button Content="加入房间" Width="150" Height="38" FontSize="18" Margin="12,0,0,0"
                        Cursor="Hand" Click="Join_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="15" Foreground="#A0522D"
                       HorizontalAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
