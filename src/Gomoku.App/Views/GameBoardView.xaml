<UserControl x:Class="Gomoku.App.Views.GameBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 动态视频背景：铺满整个窗口，作为棋盘后的场景背景（负 Margin 抵消根网格留白） -->
        <Grid x:Name="VideoBackgroundLayer" IsHitTestVisible="False" Margin="-24"
              Grid.RowSpan="3" Visibility="Collapsed">
            <MediaElement x:Name="VideoPlayerA" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                          Stretch="UniformToFill" MediaEnded="VideoPlayer_MediaEnded"
                          IsMuted="True" Opacity="1.0"/>
            <MediaElement x:Name="VideoPlayerB" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                          Stretch="UniformToFill" MediaEnded="VideoPlayer_MediaEnded"
                          IsMuted="True" Opacity="0.0"/>
        </Grid>

        <!-- 顶部状态条：加半透明底板，避免深色文字直接压在视频背景上难以辨认 -->
        <Border Grid.Row="0" Background="#E6F4E6CB" CornerRadius="10" BorderBrush="#8A6D4F"
                BorderThickness="1" Padding="14,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="← 返回" Width="70" Height="32" Click="BackButton_Click" Margin="0,0,16,0"/>
                <TextBlock x:Name="TurnText" FontSize="18" Foreground="#3B2410" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock x:Name="TimerText" FontSize="18" FontWeight="Bold" Foreground="#3B2410" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <Button x:Name="UndoButton" Content="悔棋" Width="70" Height="32" Click="UndoButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="RestartButton" Content="重开" Width="70" Height="32" Click="RestartButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="ResignButton" Content="认输" Width="70" Height="32" Click="ResignButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="FullScreenButton" Content="全屏" Width="70" Height="32" Click="FullScreen_Click" ToolTip="F11 也可切换全屏" Margin="0,0,8,0"/>
                <Button Content="测试" Width="60" Height="32" Click="DevButton_Click" ToolTip="开发者测试模块" Margin="0,0,8,0"/>
                <Button Content="退出" Width="70" Height="32" Click="Exit_Click" ToolTip="关闭游戏"/>
            </StackPanel>
        </Border>

        <!-- 棋盘区：Viewbox 自适应缩放，窗口拉大/全屏时棋盘等比铺满 -->
        <Grid Grid.Row="1">
            <Viewbox Stretch="Uniform">
                <Grid Width="570" Height="570">
                    <Canvas x:Name="BoardCanvas" Width="570" Height="570"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent" MouseLeftButtonDown="BoardCanvas_MouseLeftButtonDown"/>

                    <!-- 胜利时压暗棋盘 -->
                    <Border x:Name="DimMask" Background="#99000000" Opacity="0" IsHitTestVisible="False"/>

                    <!-- 胜利结算：悬浮贴图 -->
                    <Grid x:Name="EndOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                        <Grid.Resources>
                            <Storyboard x:Key="EndStory">
                                <DoubleAnimation Storyboard.TargetName="EndCard" Storyboard.TargetProperty="Opacity" From="0" To="0.9" Duration="0:0:0.5"/>
                                <DoubleAnimation Storyboard.TargetName="EndCardMove" Storyboard.TargetProperty="Y" From="30" To="0" Duration="0:0:0.55">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Grid.Resources>
                        <Image x:Name="EndCard" Width="360" Opacity="0" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TranslateTransform x:Name="EndCardMove" Y="30"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Grid>
            </Viewbox>

            <!-- 全屏棋盒装饰：左上黑棋盒、右下白棋盒 -->
            <Image x:Name="BlackBoxImg" Width="170" Stretch="Uniform" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,18,0,0"
                   Visibility="Collapsed" Source="/Assets/black_box.png"/>
            <Image x:Name="WhiteBoxImg" Width="170" Stretch="Uniform" IsHitTestVisible="False"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,18"
                   Visibility="Collapsed" Source="/Assets/white_box.png"/>

            <!-- 棋盘占满：和棋 / 扩展方向选择面板 -->
            <Border x:Name="BoardFullPanel" Visibility="Collapsed"
                    Background="#B83A2818" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="430" Padding="26,20,26,20"
                    BorderBrush="#E8D5A8" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="棋盘已满，请选择" FontSize="24" FontFamily="./Assets/Fonts/#Zhi Mang Xing"
                               Foreground="#F5E9D0" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="向上扩展" Width="130" Height="36" FontSize="14" Click="BoardFull_Extend_Click" Tag="0"
                            HorizontalAlignment="Center" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                        <Button Content="向左扩展" Width="115" Height="36" FontSize="14" Click="BoardFull_Extend_Click" Tag="2" Margin="0,0,12,0"/>
                        <Button Content="和棋" Width="90" Height="36" FontSize="14" Click="BoardFull_Draw_Click" Margin="0,0,12,0"/>
                        <Button Content="向右扩展" Width="115" Height="36" FontSize="14" Click="BoardFull_Extend_Click" Tag="3"/>
                    </StackPanel>
                    <Button Content="向下扩展" Width="130" Height="36" FontSize="14" Click="BoardFull_Extend_Click" Tag="1"
                            HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 开发者测试模块：一键触发场景，快速验证已有功能 -->
            <Border x:Name="DevPanel" Visibility="Collapsed"
                    Background="#D9F5E9D0" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" Padding="26,20,26,20"
                    BorderBrush="#8B5E3C" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="开发者测试" FontSize="22" FontFamily="./Assets/Fonts/#Zhi Mang Xing"
                               Foreground="#5B3A1E" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="一键触发场景，手动验证已有功能" FontSize="13"
                               Foreground="#7A5A3A" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <Button Content="一键填满棋盘（测试占满扩展）" Height="40" FontSize="15"
                            Click="DevFillBoard_Click" Margin="0,4"/>
                    <Button Content="快速获胜（测试胜利结算）" Height="40" FontSize="15"
                            Click="DevWin_Click" Margin="0,4"/>
                    <Button Content="关闭" Width="90" Height="32" FontSize="14"
                            Click="DevClose_Click" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 玩家棋盒（人机模式）：右下角棋罐，罐口露出玩家所选颜色的棋子 -->
            <Grid x:Name="PlayerBoxPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Width="150" Height="120" Margin="0,0,40,26" Visibility="Collapsed" IsHitTestVisible="False">
                <Canvas>
                    <Image x:Name="PlayerBoxImg" Source="/Assets/black_box.png" Width="150" Stretch="Uniform"
                           Canvas.Left="0" Canvas.Top="14"/>
                    <Ellipse x:Name="PlayerBoxStone1" Width="32" Height="32" Canvas.Left="59" Canvas.Top="0"/>
                    <Ellipse x:Name="PlayerBoxStone2" Width="32" Height="32" Canvas.Left="30" Canvas.Top="18"/>
                    <Ellipse x:Name="PlayerBoxStone3" Width="32" Height="32" Canvas.Left="88" Canvas.Top="18"/>
                </Canvas>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </Grid>
</UserControl>
